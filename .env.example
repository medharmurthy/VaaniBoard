# Copy to .env. Never commit real keys. Node 22 or newer is required.
AI_ENGINE=cline
AI_MODE=cline
CLINE_PROVIDER=cline
CLINE_MODEL=google/gemini-3.5-flash-lite
# CLINE_API_KEY= (server only; requests spend your Cline account credits)
CLINE_MAX_ITERATIONS=6
# Stable low-latency default for new projects; change only to a model enabled on your account.
# GEMINI_API_KEY=
# Standard pricing (verified 2026-10-10): $0.30/M input; $2.50/M output.
GEMINI_MODEL=gemini-3.5-flash-lite
# SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Optional Vertex: use YOUR project, not the original author's.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
GOOGLE_CLOUD_LOCATION=global
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
VOICE_PROVIDER=sarvam
SYLLABUS_INDEX_DIR=data/syllabus/index
SERVER_PORT=3000
NODE_ENV=development
# ALLOWED_ORIGIN=https://your-school-domain.example
USD_TO_INR_RATE=84
TELEMETRY_CONTENT_OPT_IN=false
# NCERT PDFs and derived index stay local pending redistribution permission.
